# Optional. Leave empty to use the built-in public device-flow credentials — no
# Trakt app and no VIP needed. Set these only if you own a Trakt API app and
# want your own client id/secret (https://trakt.tv/oauth/applications, redirect
# uri urn:ietf:wg:oauth:2.0:oob).
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
